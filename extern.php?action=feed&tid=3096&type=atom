		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=19703#p19703"/>
		<content type="html"><![CDATA[<div class="codebox"><pre class="vscroll"><code>CREATE OR REPLACE FUNCTION montest(test character varying)
  RETURNS void AS
$BODY$
DECLARE 

	montab smallint [3][4];
	
BEGIN
	montab[0][0]:=3;
	montab[0][1]:=4;
	montab[2][1]:=5;
	montab[2][2]:=6;
	raise notice &#039;Valeur : %&#039;, montab[2][1];

	return;
END ;
$BODY$
  LANGUAGE plpgsql VOLATILE
  COST 100;



select montest(&#039;toto&#039;);



ERREUR: indice du tableau en dehors de l&#039;échelle
État SQL :2202E</code></pre></div>]]></content>
