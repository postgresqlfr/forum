	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  Erreur d'installation sur Win XP]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=4503#p4503"/>
		<content type="html"><![CDATA[<p>L&#039;utilisateur postgres a bien les droits en lecture/écriture le répertoire data et sur tout le répertoire et les sous répertoires de C:\Program Files\Postgresql\8.3.</p>]]></content>
		<author>
			<name><![CDATA[erametadmin]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=717</uri>
		</author>
