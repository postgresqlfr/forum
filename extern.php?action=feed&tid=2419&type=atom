		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=16067#p16067"/>
		<content type="html"><![CDATA[<p>OUF, finalement j&#039;ai casté et ca marche avec ca</p><p>INSERT INTO organisation(excel_unique_id,last_audited) <br />VALUES (1,(SELECT CASE when TRIM(&#039;&#039;) = &#039;&#039; THEN (&#039;now&#039;::text)::date ELSE (TRIM(&#039;&#039;)::text)::date END));</p><p>merci</p>]]></content>
