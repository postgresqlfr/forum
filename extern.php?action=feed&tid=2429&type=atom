	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  aide pour affichage unicode]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=16115#p16115"/>
		<content type="html"><![CDATA[<p>show client_encoding;<br />me donne : UTF8</p><p>Cordialement</p>]]></content>
