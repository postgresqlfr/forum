		<title type="html"><![CDATA[Réponse à&#160;:  nb de personne par jour]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=7792#p7792"/>
		<content type="html"><![CDATA[<p>Bon, après avoir rajouté une colonne etage dans ma table d&#039;essai, pour finir, voila a quoi j&#039;arrive:</p><div class="codebox"><pre><code>DROP FUNCTION IF EXISTS nb_present(DATE);
CREATE OR REPLACE FUNCTION nb_present(oneday DATE) RETURNS TABLE(ddj DATE,etage VARCHAR, eff NUMERIC) AS
$$
SELECT $1,etage,sum(case when ($1= depart and depart=arrivee) then 1 
                when $1=depart then 0.5 
                when $1=arrivee then 0.5 
                when ($1 &gt; arrivee and $1 &lt; depart) then 1 
                else 0 end)
from essai group by etage;
$$
LANGUAGE sql;
DROP FUNCTION IF EXISTS nb_present(DATE, DATE);
select * from nb_present(&#039;2001-01-01&#039;);

DROP FUNCTION IF EXISTS nb_present(DATE,DATE);
CREATE OR REPLACE FUNCTION nb_present(datdeb DATE, datfin DATE) RETURNS TABLE(ddj DATE,etage VARCHAR, eff NUMERIC) AS
$$
DECLARE
  tmp DATE;
BEGIN
  FOR tmp IN SELECT generate_series(datdeb, datfin,&#039;1 day&#039;::interval)
  LOOP
    RETURN QUERY SELECT * from nb_present(tmp);
  END LOOP;
END
$$
LANGUAGE plpgsql;</code></pre></div><p>ce qui me permet de faire ceci:</p><div class="codebox"><pre><code>select * from nb_present(&#039;2011-01-01&#039;,&#039;2011-01-11&#039;);</code></pre></div><p>ou ceci, si je ne veux pas le détail par étage:</p><div class="codebox"><pre><code>select ddj, sum(eff) from nb_present(&#039;2011-01-01&#039;,&#039;2011-01-11&#039;) group by ddj order by 1;</code></pre></div><p>Merci pour votre aide</p><p>Cordialement</p>]]></content>
