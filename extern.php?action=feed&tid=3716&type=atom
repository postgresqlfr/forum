	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  Requête avec tableau]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=22803#p22803"/>
		<content type="html"><![CDATA[<p>Bien sûr:</p><div class="codebox"><pre><code>CREATE TABLE product_types
(
  ptypeid integer NOT NULL DEFAULT nextval(&#039;&quot;Product_Types_PTypeId_seq&quot;&#039;::regclass),
  family text,
  name text,
  fab text,
  version text,
  subversion text,
  pn text,
  description text,
  CONSTRAINT &quot;PK_Product_Type&quot; PRIMARY KEY (ptypeid)
)
WITH (
  OIDS=FALSE
);
ALTER TABLE product_types
  OWNER TO postgres;</code></pre></div>]]></content>
