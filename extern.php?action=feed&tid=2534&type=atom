		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=16713#p16713"/>
		<content type="html"><![CDATA[<p>J&#039;ai ajouté la ligne EXIT WHEN NOT FOUND, j&#039;ai initialisé&#160; s1.... et toujours rien</p><div class="codebox"><pre class="vscroll"><code>CREATE OR REPLACE FUNCTION test()
  RETURNS text AS
$BODY$

DECLARE
	s RECORD;
	s1 TEXT := &#039;&#039;;
	cur CURSOR FOR SELECT ana_id FROM tbl_analyse_ana;

BEGIN

	OPEN cur;

	LOOP
	FETCH cur INTO s;

	s1 := s1 || &#039;;&#039; || s.ana_id || &#039;;&#039;;

	EXIT WHEN NOT FOUND;
	END LOOP;

	CLOSE cur;
	RETURN s1;
END;
$BODY$
  LANGUAGE plpgsql VOLATILE
  COST 100;
ALTER FUNCTION test() OWNER TO postgres;</code></pre></div>]]></content>
