		<title type="html"><![CDATA[Réponse à&#160;:  Requete recursive ordre des elements par rapport au parent]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=18395#p18395"/>
		<content type="html"><![CDATA[<p>Bonjour,</p><p>Merci pour votre réponse.<br />J&#039;y suis finalement arrivée.<br />Voici le résultat avec le chemin pour chacun et le nombre d&#039;enfant </p><div class="codebox"><pre><code>WITH RECURSIVE child AS
					(
			                SELECT d.id,d.nom,d.parent, 0 AS level, ARRAY[CAST(id AS VARCHAR)] AS path,x.noeud
			                FROM domaine d,( select d.parent,count(*) as noeud from domaine d group by d.parent)x
			                WHERE d.id=&#039;DOM87544915&#039;
			                and x.parent=d.id
				        UNION ALL
			                SELECT d.id,d.nom,d.parent,c.level + 1 AS level, path || CAST(d.id AS VARCHAR),x.noeud
			                FROM child c JOIN domaine d ON d.parent = c.id left join ( select d.parent,count(*) as noeud from domaine d group by d.parent)x on x.parent=d.id
					)
					SELECT c.id,c.parent,c.nom,level,path,noeud
					FROM child c
					ORDER BY path</code></pre></div>]]></content>
