		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=24342#p24342"/>
		<content type="html"><![CDATA[<p><a href="https://s16.postimg.org/4v51a6ez9/Capture5.jpg" rel="nofollow">https://s16.postimg.org/4v51a6ez9/Capture5.jpg</a></p><p>---<br />CREATE TRIGGER tr_insert_taux<br />&#160; &#160; after INSERT ON table1<br />&#160; &#160; FOR EACH ROW<br />&#160; &#160; EXECUTE PROCEDURE fc_insert_taux();<br />---<br />create or replace function fc_insert_taux() RETURNS text AS $$<br />begin<br />update table1<br />set table1.taux=table2.taux<br />where table2.id=table1.id_usager<br />end;</p>]]></content>
