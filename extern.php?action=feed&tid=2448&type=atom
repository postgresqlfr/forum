		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=16213#p16213"/>
		<content type="html"><![CDATA[<p>Bonjour à tous je le script SQLServer suivant et je cherche à le passer sous PostGresSQL, quelqu&#039;un pourrait-il m&#039;aider svp ?</p><p>Merci</p><p>DECLARE @state char(100);<br />SET @state = (SELECT DATA_TYPE FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = &#039;Interaction&#039; AND COLUMN_NAME = &#039;IntPlace&#039;);<br />IF &#039;char&#039; = @state<br />&#160; &#160; BEGIN<br />&#160; &#160; &#160; &#160; PRINT &#039;IntPlace is a char DATA_TYPE&#039;<br />&#160; &#160; &#160; &#160; IF 350 &gt; (SELECT CHARACTER_MAXIMUM_LENGTH FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = &#039;Interaction&#039; AND COLUMN_NAME = &#039;IntPlace&#039;)<br />&#160; &#160; &#160; &#160; &#160; &#160; BEGIN<br />&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; PRINT &#039;IntPlace is smaller than 350&#039;;<br />&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; ALTER TABLE Interaction ALTER COLUMN IntPlace char(350);<br />&#160; &#160; &#160; &#160; &#160; &#160; END<br />&#160; &#160; END<br />&#160; &#160; &#160; &#160; <br />IF &#039;varchar&#039; = @state<br />&#160; &#160; BEGIN<br />&#160; &#160; &#160; &#160; PRINT &#039;IntPlace is a varchar DATA_TYPE&#039;<br />&#160; &#160; &#160; &#160; IF 350 &gt; (SELECT CHARACTER_MAXIMUM_LENGTH FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = &#039;Interaction&#039; AND COLUMN_NAME = &#039;IntPlace&#039;)<br />&#160; &#160; &#160; &#160; &#160; &#160; BEGIN<br />&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; PRINT &#039;IntPlace is smaller than 350&#039;;<br />&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; ALTER TABLE Interaction ALTER COLUMN IntPlace varchar(350);<br />&#160; &#160; &#160; &#160; &#160; &#160; END<br />&#160; &#160; END<br />&#160; &#160; &#160; &#160; <br />IF &#039;nvarchar&#039; = @state<br />&#160; &#160; BEGIN<br />&#160; &#160; &#160; &#160; PRINT &#039;IntPlace is a nvarchar DATA_TYPE&#039;<br />&#160; &#160; &#160; &#160; IF 350 &gt; (SELECT CHARACTER_MAXIMUM_LENGTH FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = &#039;Interaction&#039; AND COLUMN_NAME = &#039;IntPlace&#039;)<br />&#160; &#160; &#160; &#160; &#160; &#160; BEGIN<br />&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; PRINT &#039;IntPlace is smaller than 350&#039;;<br />&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; ALTER TABLE Interaction ALTER COLUMN IntPlace nvarchar(350);<br />&#160; &#160; &#160; &#160; &#160; &#160; END<br />&#160; &#160; END<br />&#160; &#160; <br />IF &#039;nchar&#039; = @state<br />&#160; &#160; BEGIN<br />&#160; &#160; &#160; &#160; PRINT &#039;IntPlace is a nchar DATA_TYPE&#039;<br />&#160; &#160; &#160; &#160; IF 350 &gt; (SELECT CHARACTER_MAXIMUM_LENGTH FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = &#039;Interaction&#039; AND COLUMN_NAME = &#039;IntPlace&#039;)<br />&#160; &#160; &#160; &#160; &#160; &#160; BEGIN<br />&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; PRINT &#039;IntPlace is smaller than 350&#039;;<br />&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; ALTER TABLE Interaction ALTER COLUMN IntPlace nchar(350);<br />&#160; &#160; &#160; &#160; &#160; &#160; END<br />&#160; &#160; END</p>]]></content>
