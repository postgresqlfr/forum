		<content type="html"><![CDATA[<p>j&#039;ai trouver cet fonction dans le document officiel et que j&#039;ai utilisé et qui m&#039;a bien retourné le lastinsertid </p><br /><div class="codebox"><pre><code>public function pgsqlLastInsertId($sqlQuery, $pdoObject)
	{
   		 // Checks if query is an insert and gets table name
   		 if( preg_match(&quot;/^INSERT[\t\n ]+INTO[\t\n ]+([a-z0-9\_\-]+)/is&quot;, $sqlQuery, $tablename) )
    	 {
        		// Gets this table&#039;s last sequence value
        		$query = &quot;SELECT currval(&#039;&quot; . $tablename[1] . &quot;_id_seq&#039;) AS last_value&quot;;

        		$temp_q_id = $this-&gt;prepared($query);
        		$temp_q_id-&gt;execute();

        		if($temp_q_id)
        		{
            			$temp_result = $temp_q_id-&gt;fetch(PDO::FETCH_ASSOC);
            			return ( $temp_result ) ? $temp_result[&#039;last_value&#039;] : false;
        		}
    	}

    	return false;
	}</code></pre></div><p>merci :-)</p>]]></content>
