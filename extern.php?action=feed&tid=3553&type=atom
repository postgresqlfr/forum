		<title type="html"><![CDATA[Réponse à&#160;:  ORDER BY sur un champ mixte]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=21991#p21991"/>
		<content type="html"><![CDATA[<p>Bonjour,</p><p>Tu peux utiliser une fonction pour ton ORDER BY, qui prend en argument ta valeur, et qui doit la transformer en une valeur qui permet de classer correctement.</p><p>create function ordre(str varchar)<br />RETURNS varchar<br />LANGUAGE plpgsql<br />AS $$<br />BEGIN<br />&#160; &#160;RETURN CASE WHEN str &lt; &#039;A&#039; THEN lpad(str, 255, &#039;0&#039;) ELSE str END;<br />END;<br />$$;</p><p>select ordre(content), content from tab order by ordre(content);</p>]]></content>
