		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=34278#p34278"/>
		<content type="html"><![CDATA[<p>Bonjour,<br />Qu&#039;entendez-vous par version personnalisés de pg_restore ?</p>]]></content>
		<author>
			<name><![CDATA[noob_postgres]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=11065</uri>
		</author>
