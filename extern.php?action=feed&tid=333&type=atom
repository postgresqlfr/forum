			<name><![CDATA[lo²]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=424</uri>
		</author>
		<updated>2009-07-01T08:49:21Z</updated>
		<id>http://forums.postgresql.fr/viewtopic.php?pid=1864#p1864</id>
