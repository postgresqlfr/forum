		<title type="html"><![CDATA[Réponse à&#160;:  RESOLU - récupération résultat requête dans une variable]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=16892#p16892"/>
		<content type="html"><![CDATA[<p>C&#039;est effectivement plus simple!</p><p>Voici donc la fonction finale</p><div class="codebox"><pre><code>CREATE OR REPLACE FUNCTION arrondi(NUMERIC, INTEGER) 
RETURNS NUMERIC as 
$$
DECLARE 
nb INTEGER;

BEGIN
SELECT INTO nb ana_decimal FROM tbl_analyse_ana WHERE ana_id = $2;

RETURN ROUND($1, nb);

END;
$$
  LANGUAGE plpgsql VOLATILE</code></pre></div>]]></content>
