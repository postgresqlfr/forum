	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  Auto incrémentation depuis un fichier CSV]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=33427#p33427"/>
		<content type="html"><![CDATA[<p>Comment choisit on ce type SERIAL ?</p>]]></content>
		<author>
			<name><![CDATA[Anntoinee]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=10218</uri>
		</author>
