		<title type="html"><![CDATA[Réponse à&#160;:  jointure externe postgres ?]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=4118#p4118"/>
		<content type="html"><![CDATA[<p>voir ci dessous ca marche pas !<br />coment on fais ? merci </p><p>select p2.id_parc,p1.nblog1990,p2.nblog2006 from</p><br /><p>( <br />select id_parc&#160; ,count(*)&#160; as nblog1990 <br />from bat p1 <br />where dte in (&#039;1&#039;,&#039;2&#039;) <br />and ja &lt; &#039;1991&#039; or ja is null<br />and id_parc =&#039;04049AL1080&#039;<br />group by id_parc<br />)p1<br />,<br />( <br />select id_parc&#160; ,count(*)&#160; as nblog2006<br />from bat p1 <br />where dte in (&#039;1&#039;,&#039;2&#039;) <br />and id_parc =&#039;04049AL1080&#039;<br />group by id_parc<br />)p2,<br />LEFT JOIN p2.id_parc1 AS c ON p1.id_parc = p2.id_parc</p>]]></content>
