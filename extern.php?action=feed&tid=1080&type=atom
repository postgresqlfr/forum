		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=6832#p6832"/>
		<content type="html"><![CDATA[<p>Ah, c&#039;est en plpgsql que c&#039;est le moins élégant <img src="http://forums.postgresql.fr/img/smilies/smile.png" width="15" height="15" alt="smile" /> :</p><br /><p>CREATE function test_rowcount () returns integer LANGUAGE plpgsql AS<br />$$<br />DECLARE<br />&#160; nb_update integer;<br />BEGIN&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;<br />&#160; UPDATE test SET a=a+1000 where a&gt; 600;<br />&#160; GET DIAGNOSTICS nb_update = ROW_COUNT;<br />&#160; RETURN nb_update;<br />END;&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;<br />$$<br />;</p><br /><p>SELECT test_rowcount();<br /> test_rowcount <br />---------------<br />&#160; &#160; &#160; &#160; &#160; &#160;400</p>]]></content>
