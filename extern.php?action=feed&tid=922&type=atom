		<content type="html"><![CDATA[<p>Ça s&#039;écrit comme ça sous PostgreSQL:</p><p>CREATE TABLE matable(<br />&#160; ID CHAR(10) NOT NULL,<br />&#160; attribut2 CHAR(10) NULL,<br />&#160; attribut3 CHAR(10) NULL,<br />&#160; attribut4 CHAR(10) NULL,<br />&#160; PRIMARY KEY(ID),<br />&#160; constraint&#160; PROGRAMMATION_UNIQUE unique(attribut2 ,attribut3 ,attribut4)<br />);</p>]]></content>
