		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=19468#p19468"/>
		<content type="html"><![CDATA[<p>Testé chez moi :</p><div class="codebox"><pre><code>CREATE OR REPLACE function special_round(p_to_round decimal,p_nbre_decimal integer) RETURNS decimal AS $$
DECLARE
	p_return decimal;
BEGIN
	IF(round(p_to_round,p_nbre_decimal)&lt;p_to_round) THEN
		p_to_round := p_to_round + 9 /10^(p_nbre_decimal+1);
	END IF;
	p_return := round(p_to_round,p_nbre_decimal);
	RETURN p_return;
END;
$$ LANGUAGE plpgsql;</code></pre></div><br /><p>Tests :</p><div class="codebox"><pre><code>test=# select * from special_round(123.121958,2);
 special_round 
---------------
        123.13
(1 row)
test=# select * from special_round(123.120,3);
 special_round 
---------------
       123.120
(1 row)</code></pre></div>]]></content>
