		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=17131#p17131"/>
		<content type="html"><![CDATA[<p>Chose promise, chose due !</p><p>Voilà finalement mon trigger ! Tout simple, mais quand on connait pas...</p><p>Merci beaucoup pour votre aide.</p><p>CREATE FUNCTION update_fct() RETURNS trigger<br />&#160; &#160; LANGUAGE plpgsql<br />&#160; &#160; AS $$<br />DECLARE<br />nb_item bigint;<br />nb_credits bigint;<br />BEGIN<br />&#160; &#160; SELECT INTO nb_item COUNT(*) FROM xxx WHERE xxx = NEW.id;<br />&#160; &#160; SELECT INTO nb_credits SUM(credits) FROM yyyy WHERE zzz = NEW.id;<br />&#160; &#160; UPDATE ddd SET nb_items=nb_item,credits=nb_credits,modified=NOW() WHERE id = NEW.id;<br />&#160; &#160; RETURN NULL;<br />END;$$;<br />CREATE TRIGGER update_fct AFTER INSERT OR UPDATE ON xxx FOR EACH ROW EXECUTE PROCEDURE update_fct();</p>]]></content>
