	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  pgbench-performances de postgres8.4]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=14492#p14492"/>
		<content type="html"><![CDATA[<p>pourquoi rester en 8.4 d&#039;ailleurs ?</p>]]></content>
		<author>
			<name><![CDATA[kenrio]]></name>
