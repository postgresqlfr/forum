		<title type="html"><![CDATA[Réponse à&#160;:  Requête de regroupement sur une période glissante]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=12912#p12912"/>
		<content type="html"><![CDATA[<p>Cette requête n&#039;est-elle pas suffisante :</p><div class="codebox"><pre><code>CREATE TABLE T
(esp INT,
 num INT,
periode INT
) 
INSERT INTO T
VALUES 
(1, 563, 1001),
(1, 2040, 1001),
(1, 12, 1001),
(1, 123, 1001),
(1, 987, 1001),
(1, 563, 1002),
(1, 569, 1002),
(1, 12, 1002),
(1, 13, 1002),
(1, 563, 1003),
(1, 569, 1003),
(1, 2040, 1003),
(1, 12, 1003),
(1, 123, 1003),
(1, 6, 1003);


SELECT T1.periode, T1.num
FROM   T AS T1
       INNER JOIN T AS T2
             ON T1.periode = T2.periode -1
                AND T1.num = T2.num</code></pre></div><p>???</p><p>A +</p>]]></content>
