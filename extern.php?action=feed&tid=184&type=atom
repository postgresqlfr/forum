	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  vue modifiable]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=6635#p6635"/>
		<content type="html"><![CDATA[<p>Bonjour<br />J&#039;ai une vue sur une table et je voudrais une régle pour la mise à jour de la table mais mon problème c&#039;est la récupération&#160; des données et l&#039;envoi vers la fonction appropriée.</p><p>Ci dessous une de mes tentative non fonctionnelles.</p><div class="codebox"><pre><code>CREATE rule mavue_upadate AS ON UPDATE TO une_vue DO INSTEAD SELECT updatemavue_trigger(NEW)</code></pre></div><div class="codebox"><pre class="vscroll"><code>CREATE OR REPLACE FUNCTION updatemavue_trigger(enreg record) RETURNS void AS $$
DECLARE
	un_enreg enreg%ROWTYPE;
	msql varchar :=&#039;&#039;;
	i integer default 0;
BEGIN
	SELECT * INTO un_enreg FROM matable WHERE id=enreg.id;
	IF FOUND THEN
		
		IF un_enreg.nom &lt;&gt; enreg.nom THEN
			msql := &#039;nom = &#039; || enreg.nom;
			i:=1;
		END IF;
		
		IF un_enreg.prenom &lt;&gt; enreg.prenom AND i&lt;&gt;0 THEN
			msql := msql || &#039; AND prenom=&#039; || enreg.prenom;
		ELSE
			msql := &#039;prenom=&#039; || enreg.prenom;
			i:=1;
		END IF;
						
		IF i&lt;&gt;0 THEN
			EXECUTE &#039;UPDATE matable SET &#039; || msql;
		END IF;
		
	else
		RAISE EXCEPTION &#039;Update impossible&#039;;
	END IF;
END;
$$
LANGUAGE plpgsql;</code></pre></div>]]></content>
