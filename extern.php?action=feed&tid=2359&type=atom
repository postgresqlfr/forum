 &#160; &#160;|&#160; &#160; &#160; &#160; &#160; | 2/1885342&#160; &#160; &#160; &#160; &#160; | 23932 | AccessShareLock | t<br /> virtualxid |&#160; &#160; &#160; &#160; &#160; |&#160; &#160; &#160; &#160; &#160; |&#160; &#160; &#160; |&#160; &#160; &#160; &#160;| 2/1885342&#160; |&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;|&#160; &#160; &#160; &#160; &#160;|&#160; &#160; &#160; &#160;|&#160; &#160; &#160; &#160; &#160; | 2/1885342&#160; &#160; &#160; &#160; &#160; | 23932 | ExclusiveLock&#160; &#160;| t</p>]]></content>
