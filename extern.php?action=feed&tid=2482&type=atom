	<entry>
		<title type="html"><![CDATA[les tables créées avec pgadmin sont enregistrées dans la mauvaise base]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=16420#p16420"/>
		<content type="html"><![CDATA[<p>Bonjour,</p><p>En utilisant l&#039;éditeur de requêtes sql query, mes tables sont enregistrées dans la base postgres au lieu de ma_base. Voici le code écrit dans le même éditeur (ici j&#039;ai enlevé les types de données) :</p><br /><p>create database ma_base&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; </p><p>create table temps<br />(ville <br />basse_temp&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; <br />haute_temp&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; <br />pluie&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; <br />date);&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; </p><p>create table villes<br />(nom&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; <br />emplacement);</p><p>postgresql 9.2 - windows 7</p>]]></content>
