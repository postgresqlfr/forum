  RETURNS character varying AS
$BODY$
DECLARE
rec  RECORD ;
col text;
table_name alias for $1 ;
BEGIN
col = &#039;id&#039;;
  EXECUTE&#039;SELECT rec FROM f_table_name = &#039; ||
    quote_literal(table_name) &#039;WHERE f_table_column = &#039;|| quote_literal(col) and  table_name.col= $2;

    
     RETURN rec.road_name;
END;
$BODY$
  LANGUAGE &#039;plpgsql&#039; VOLATILE
  COST 100;</code></pre></div><p>et j ai la&#160; resultat suivante :<br />ERROR:&#160; type &quot;quote_literal&quot; does not exist<br />merci d&#039;avance <br />imen</p>]]></content>
