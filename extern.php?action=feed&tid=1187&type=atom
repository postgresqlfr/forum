	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  liste des membres d'un groupe]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=7635#p7635"/>
		<content type="html"><![CDATA[<p>select member.rolname as member from pg_auth_members join pg_roles member on (pg_auth_members.member=member.oid)<br />where pg_auth_members.roleid in ( select oid from pg_roles where rolname = &#039;legroupe&#039;);</p>]]></content>
