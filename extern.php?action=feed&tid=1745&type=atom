		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=11851#p11851"/>
		<content type="html"><![CDATA[<p>Comment puisse je spécifier -h ?</p>]]></content>
		<author>
			<name><![CDATA[marcandre]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=354</uri>
