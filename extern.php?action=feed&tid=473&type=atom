	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  Respect de la casse dans les requetes]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=2884#p2884"/>
		<content type="html"><![CDATA[<p>Il est aussi possible d&#039;utiliser ILIKE :</p><div class="codebox"><pre><code>WHERE designation ILIKE &#039;%fauteuil%&#039;</code></pre></div>]]></content>
		<author>
			<name><![CDATA[gleu]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=3</uri>
		</author>
		<updated>2009-11-07T17:38:00Z</updated>
