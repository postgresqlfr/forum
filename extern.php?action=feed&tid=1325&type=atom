		<content type="html"><![CDATA[<p>oui c&#039;est une fonction qui renvoie un setof d&#039;un objet <br />CREATE OR REPLACE FUNCTION b(x character varying)<br />&#160; RETURNS SETOF c_object AS<br />$BODY$<br />BEGIN<br />&#160; &#160; RETURN QUERY SELECT getItem_id::varchar(30), model_id, CAST(item_id AS varchar(30)), item_family_id, manager_id, local_manager_id,<br />&#160; &#160; &#160; &#160; unit_code_id, decimal_size, internal_cost_qty, bom_qty, <br />&#160; &#160; &#160; &#160; title_percent, bom_level, model_marketable, technical_index, <br />&#160; &#160; &#160; &#160; current_index, customs_code, item_state, kit <br />&#160; &#160; &#160; &#160; FROM model, getitem_id(x) WHERE model_id = getmodel(x);<br />END;<br />$BODY$<br />&#160; LANGUAGE plpgsql VOLATILE<br />&#160; COST 100<br />&#160; ROWS 1000;</p>]]></content>
