		<content type="html"><![CDATA[<p>ce serait du genre</p><div class="codebox"><pre><code> FROM
n_bdt_bati_indifferencie_s_000 LEFT JOIN n_apr_bati_l_000 
    ON (n_bdt_bati_indifferencie_s_000.id = n_apr_bati_l_000.id_bat)
LEFT JOIN n_apr_adresse_p_000 
    ON (n_apr_adresse_p_000.id = n_apr_bati_l_000.id_adr)</code></pre></div>]]></content>
