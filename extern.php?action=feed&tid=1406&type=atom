		<title type="html"><![CDATA[Réponse à&#160;:  Trigger gestion stock]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=9325#p9325"/>
		<content type="html"><![CDATA[<p>MERCI <img src="http://forums.postgresql.fr/img/smilies/wink.png" width="15" height="15" alt="wink" /></p><p>ça marche</p><p>Voila mon code</p><div class="codebox"><pre><code>CREATE FUNCTION maj_etat_stock() RETURNS trigger AS $maj_etat_stock$
    BEGIN
    
         -- Verifie que etat_article est donnés
        IF NEW.etat_article IS NULL THEN
            RAISE EXCEPTION &#039;etat_article ne peut pas être NULL&#039;;
        END IF;
        
        -- Verifie si la quantité en à ajouter / mettre à jour est &gt; a la qte min en stock
        IF NEW.quantite_stock &gt; NEW.quantite_stock_min THEN

        -- Mettre l&#039;état &#039;EN STOCK&#039;
         NEW.etat_article  := &#039;EN STOCK&#039;;
         
         ELSE
          -- Mettre l&#039;état &#039;A COMMANDER&#039;
          NEW.etat_article  := &#039;A COMMANDER&#039;;
 
        END IF;
        
        RETURN NEW;
        
    END;
$maj_etat_stock$ LANGUAGE plpgsql;

CREATE TRIGGER maj_etat_stock BEFORE INSERT OR UPDATE ON articles
    FOR EACH ROW EXECUTE PROCEDURE maj_etat_stock();</code></pre></div>]]></content>
