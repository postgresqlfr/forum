	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  bulk collect]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=13778#p13778"/>
		<content type="html"><![CDATA[<p>Évidemment, dans ce cas, l&#039;update devient </p><div class="codebox"><pre><code>     UPDATE TMP_ENTCDECLI
        SET   ETAT_INT = 3
        WHERE ctid = mon_ctid_que_j_ai_recupere_dans_mon_fetch</code></pre></div>]]></content>
		<author>
			<name><![CDATA[Marc Cousin]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=312</uri>
