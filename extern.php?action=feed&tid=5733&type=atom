			<name><![CDATA[jmarsac]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=7302</uri>
		</author>
		<updated>2020-04-09T21:19:49Z</updated>
		<id>http://forums.postgresql.fr/viewtopic.php?pid=31027#p31027</id>
