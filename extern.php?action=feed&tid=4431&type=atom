CREATE OR REPLACE FUNCTION swap_items(current_cheminement varchar, nd1 varchar, nd2 varchar)
RETURNS void AS
$$
DECLARE
BEGIN
Update sortCables set cm_ndcode1 = nd2 where cm_code = current_cheminement;
Update sortCables set cm_ndcode2 = nd1 where cm_code = current_cheminement; 
END
$$ LANGUAGE plpgsql VOLATILE;

CREATE OR REPLACE FUNCTION recursivite(nd1 varchar, nd1Old varchar)
RETURNS void AS
$$
DECLARE
parent record;
enfants record;
BEGIN
FOR parent IN
      SELECT * FROM sortCables where cm_ndcode1 = nd1
   LOOP
	FOR enfants IN
		SELECT * FROM sortCables where cm_ndcode2 = nd1
		LOOP
			PERFORM swap_items(enfants.cm_code, enfants.cm_ndcode1, enfants.cm_ndcode2);
			PERFORM recursivite(enfants.cm_ndcode1,parent.cm_ndcode2);
		END LOOP;
   END LOOP;
END
$$ LANGUAGE plpgsql VOLATILE;

