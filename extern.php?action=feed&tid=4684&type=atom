		<content type="html"><![CDATA[<p>Oui, et il interdit toute ambiguité</p><div class="codebox"><pre><code># create function f1(v1 text) returns void as $$
begin
raise notice &#039;test&#039;;
end; $$ language plpgsql;
CREATE FUNCTION

# create function f1(v1 text, v2 text default &#039;&#039;) returns void as $$
begin
raise notice &#039;test&#039;;
end; $$ language plpgsql;

# select f1(&#039;test&#039;::text);
ERROR:  42725: function f1(text) is not unique
LINE 1: select f1(&#039;test&#039;::text);
               ^
HINT:  Could not choose a best candidate function. You might need to add explicit type casts.</code></pre></div>]]></content>
