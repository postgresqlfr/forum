; &#160; &lt;row NAME=&quot;C0ZOBS&quot; TEXT=&quot;OBSERVATIONS&quot; ORD=&quot;25&quot; TYP=&quot;character&quot; LEN=&quot;30&quot; ENT=&quot;0&quot; DEC=&quot;0&quot; LNG=&quot;30&quot;/&gt;<br />&#160; &#160; &#160; &#160; &lt;row NAME=&quot;C0ZTVA&quot; TEXT=&quot;REFERENCE TVA&quot; ORD=&quot;26&quot; TYP=&quot;character&quot; LEN=&quot;15&quot; ENT=&quot;0&quot; DEC=&quot;0&quot; LNG=&quot;15&quot;/&gt;<br />&#160; &#160; &#160; &#160; &lt;row NAME=&quot;C0ZRU1&quot; TEXT=&quot;NOM / RUE1&quot; ORD=&quot;27&quot; TYP=&quot;character&quot; LEN=&quot;30&quot; ENT=&quot;0&quot; DEC=&quot;0&quot; LNG=&quot;30&quot;/&gt;<br />&#160; &#160; &#160; &#160; &lt;row NAME=&quot;C0ZRU2&quot; TEXT=&quot;SUITE NOM / RUE1&quot; ORD=&quot;28&quot; TYP=&quot;character&quot; LEN=&quot;30&quot; ENT=&quot;0&quot; DEC=&quot;0&quot; LNG=&quot;30&quot;/&gt;<br />&#160; &#160; &#160; &#160; &lt;row NAME=&quot;C0ZTL1&quot; TEXT=&quot;N. TEL. PERS. A CONT&quot; ORD=&quot;29&quot; TYP=&quot;character&quot; LEN=&quot;15&quot; ENT=&quot;0&quot; DEC=&quot;0&quot; LNG=&quot;15&quot;/&gt;<br />&#160; &#160; &#160; &#160; &lt;row NAME=&quot;C0ZTLX&quot; TEXT=&quot;N. TELEX / TELECOPIE&quot; ORD=&quot;30&quot; TYP=&quot;character&quot; LEN=&quot;15&quot; ENT=&quot;0&quot; DEC=&quot;0&quot; LNG=&quot;15&quot;/&gt;<br />&#160; &#160; &#160; &#160; &lt;row NAME=&quot;C0ZVIL&quot; TEXT=&quot;VILLE&quot; ORD=&quot;31&quot; TYP=&quot;character&quot; LEN=&quot;25&quot; ENT=&quot;0&quot; DEC=&quot;0&quot; LNG=&quot;25&quot;/&gt;<br />&#160; &#160; &lt;/ZONED&gt;<br />&#160; &#160; &lt;ZONEK&gt;<br />&#160; &#160; &#160; &#160; &lt;row NAME=&quot;C0NCLI&quot; ORD=&quot;1&quot; TYP=&quot;numeric&quot; LEN=&quot;0&quot; ENT=&quot;6&quot; DEC=&quot;0&quot; LNG=&quot;7&quot;/&gt;<br />&#160; &#160; &lt;/ZONEK&gt;<br />&lt;/FILE&gt;<br /></em></p>]]></content>
