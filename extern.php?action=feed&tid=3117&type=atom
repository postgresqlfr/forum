		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=19793#p19793"/>
		<content type="html"><![CDATA[<p>Celle là fonctionne bien :</p><div class="codebox"><pre><code>test=# CREATE OR REPLACE FUNCTION unite_s (x decimal ) returns decimal AS $corps$
Begin
 return (  x /1000)::decimal(7,3) ;
end;
$corps$
LANGUAGE PLPGSQL;
CREATE FUNCTION
test=# select * from unite_s(465551);
 unite_s 
---------
 465.551
(1 row)</code></pre></div>]]></content>
