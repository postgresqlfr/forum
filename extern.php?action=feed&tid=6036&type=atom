			<name><![CDATA[stephane.lorek]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=9486</uri>
		</author>
		<updated>2021-06-08T13:59:40Z</updated>
		<id>http://forums.postgresql.fr/viewtopic.php?pid=32564#p32564</id>
