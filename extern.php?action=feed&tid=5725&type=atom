			<name><![CDATA[pifor]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=8375</uri>
		</author>
		<updated>2020-03-25T09:44:37Z</updated>
		<id>http://forums.postgresql.fr/viewtopic.php?pid=30971#p30971</id>
	</entry>
