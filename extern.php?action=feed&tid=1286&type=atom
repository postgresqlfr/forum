		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=11225#p11225"/>
		<content type="html"><![CDATA[<p>Salut cher ami,<br />voila la solution que jài trouvé, ca marche nikel</p><p>local&#160; &#160;all&#160; &#160; &#160; &#160; &#160; &#160; &#160;all&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;trust<br /># IPv4 local connections:<br />host&#160; &#160; all&#160; &#160; &#160; &#160; &#160; &#160; &#160;all&#160; &#160; &#160; &#160; &#160; &#160; &#160;127.0.0.1/32&#160; &#160; &#160; &#160; &#160; &#160; md5<br /># add by ismaila<br />host&#160; &#160; all&#160; &#160; &#160; &#160; &#160; &#160; &#160;all&#160; &#160; &#160; &#160; &#160; &#160; &#160;192.168.7.0/24&#160; &#160; &#160; &#160; &#160; md5<br /># IPv6 local connections:<br />host&#160; &#160; all&#160; &#160; &#160; &#160; &#160; &#160; &#160;all&#160; &#160; &#160; &#160; &#160; &#160; &#160;::1/128&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;md5<br />#modif ismaila<br />hostssl all&#160; &#160; &#160; &#160; &#160; &#160; &#160;all&#160; &#160; &#160; &#160; &#160; &#160; &#160;192.168.7.0/24&#160; &#160; &#160; &#160; &#160; md5<br />hostssl all&#160; &#160; &#160; &#160; &#160; &#160; &#160;all&#160; &#160; &#160; &#160; &#160; &#160; &#160;::ffff:192.168.0.0/120&#160; md5</p>]]></content>
