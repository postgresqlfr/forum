		<content type="html"><![CDATA[<p>Au temps pour moi. Chose faite :</p><div class="quotebox"><blockquote><div><p>model_gfs_025=&gt; select * from pg_statio_user_indexes;<br /> relid | indexrelid | schemaname |&#160; &#160;relname&#160; &#160; |&#160; indexrelname&#160; &#160;| idx_blks_read | idx_blks_hit <br />-------+------------+------------+--------------+-----------------+---------------+--------------<br /> 24592 |&#160; &#160; &#160; 24605 | public&#160; &#160; &#160;| last_run_025 | lat_lng_gfs_025 |&#160; &#160; &#160; &#160;5708574 |&#160; &#160; &#160; &#160; &#160; &#160;85<br />(1 ligne)</p></div></blockquote></div><div class="quotebox"><blockquote><div><p>model_gfs_025=&gt; select * from pg_statio_user_tables;<br /> relid | schemaname |&#160; &#160;relname&#160; &#160; | heap_blks_read | heap_blks_hit | idx_blks_read | idx_blks_hit | toast_blks_read | toast_blks_hit | tidx_blks_read | tidx_blks_hit <br />-------+------------+--------------+----------------+---------------+---------------+--------------+-----------------+----------------+----------------+---------------<br /> 24592 | public&#160; &#160; &#160;| last_run_025 |&#160; &#160; &#160; &#160;23970250 |&#160; &#160; &#160; 22113815 |&#160; &#160; &#160; &#160;5708574 |&#160; &#160; &#160; &#160; &#160; &#160;85 |&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;|&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; |&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; |&#160; &#160; &#160; &#160; &#160; &#160; &#160; <br />(1 ligne)</p></div></blockquote></div>]]></content>
