	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  davical postgresql]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=3212#p3212"/>
		<content type="html"><![CDATA[<p># Database administrative login by UNIX sockets<br />local&#160; &#160;all&#160; &#160; &#160; &#160; &#160;postgres&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; ident sameuser</p><p># TYPE&#160; DATABASE&#160; &#160; USER&#160; &#160; &#160; &#160; CIDR-ADDRESS&#160; &#160; &#160; &#160; &#160; METHOD</p><p># &quot;local&quot; is for Unix domain socket connections only<br />local&#160; &#160;all&#160; &#160; &#160; &#160; &#160;all&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; ident sameuser<br /># IPv4 local connections:<br />host&#160; &#160; all&#160; &#160; &#160; &#160; &#160;all&#160; &#160; &#160; &#160; &#160;127.0.0.1/32&#160; &#160; &#160; &#160; &#160; md5<br /># IPv6 local connections:<br />host&#160; &#160; all&#160; &#160; &#160; &#160; &#160;all&#160; &#160; &#160; &#160; &#160;::1/128&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;md5</p>]]></content>
