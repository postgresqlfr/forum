		<id>http://forums.postgresql.fr/viewtopic.php?pid=3170#p3170</id>
	</entry>
	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  davical postgresql]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=3169#p3169"/>
		<content type="html"><![CDATA[<p>Version Cluster&#160; &#160;Port Status Owner&#160; &#160; Data directory&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;Log file<br />8.3&#160; &#160; &#160;main&#160; &#160; &#160; 5432 online postgres /var/lib/postgresql/8.3/main&#160; &#160; &#160; &#160;/var/log/postgresql/postgresql-8.3-main.log<br />8.4&#160; &#160; &#160;main&#160; &#160; &#160; 5433 down&#160; &#160;postgres /var/lib/postgresql/8.4/main&#160; &#160; &#160; &#160;/var/log/postgresql/postgresql-8.4-main.log</p>]]></content>
