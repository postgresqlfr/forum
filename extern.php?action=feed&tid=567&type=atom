0; &#160; &#160; &#160; &#160;0 |&#160; &#160; &#160; &#160; &#160; 9 |&#160; &#160; &#160; &#160; 0 |&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; |&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; |&#160; &#160; &#160; &#160; &#160; &#160; &#160;|<br /> jbm_id_cache&#160; &#160;|&#160; &#160; &#160; &#160; &#160; &#160; &#160;500 |&#160; &#160; &#160;767236 |&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;0 |&#160; &#160; &#160; &#160; 500 |&#160; &#160; &#160; &#160; 0 | 13/01/2010 15:23 | 13/01/2010 15:23 |&#160; &#160; &#160; &#160; &#160; &#160; &#160;|<br /><strong> jbm_msg&#160; &#160; &#160; &#160; |&#160; &#160; &#160; &#160; &#160; 767736 |&#160; &#160; &#160; &#160; &#160; 0 |&#160; &#160; &#160; &#160; &#160; &#160; 767111 |&#160; &#160; &#160; &#160;7417 |&#160; &#160;757008 | 13/01/2010 15:06 | 13/01/2010 15:02 |&#160; &#160; &#160; &#160; &#160; &#160; &#160;|</strong><br /> jbm_postoffice |&#160; &#160; &#160; &#160; &#160; &#160; &#160; 26 |&#160; &#160; &#160; &#160; &#160; 0 |&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;0 |&#160; &#160; &#160; &#160; &#160;26 |&#160; &#160; &#160; &#160; 0 |&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; |&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; |&#160; &#160; &#160; &#160; &#160; &#160; &#160;|<br /> jbm_msg_ref&#160; &#160; |&#160; &#160; &#160; &#160; &#160; 767736 |&#160; &#160; 1994168 |&#160; &#160; &#160; &#160; &#160; &#160; 767135 |&#160; &#160; &#160; &#160; 181 |&#160; &#160; 15777 | 13/01/2010 15:31 | 13/01/2010 15:31 |&#160; &#160; &#160; &#160; &#160; &#160; &#160;|<br /> jbm_dual&#160; &#160; &#160; &#160;|&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;1 |&#160; &#160; &#160; &#160; &#160; 0 |&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160;0 |&#160; &#160; &#160; &#160; &#160; 1 |&#160; &#160; &#160; &#160; 0 |&#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; &#160; |&#160; 