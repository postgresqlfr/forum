		<title type="html"><![CDATA[Réponse à&#160;:  The Microsoft Access database engine stopped the process...]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=25677#p25677"/>
		<content type="html"><![CDATA[<p>Voici le trigger qui historise dans le schema &#039;deleted&#039; qui contient toutes les tables du schema public et qui sont vides à l&#039;origine des temps :</p><div class="codebox"><pre><code>CREATE OR REPLACE FUNCTION public.audit_d()
  RETURNS trigger AS
$BODY$
declare
        stmt    varchar;
begin

        insert into public.audit_history
                (table_name, operation, audit_id, user_name, audit_date)
        values
                (TG_TABLE_NAME, TG_OP, old.audit_id, current_user, now());

        stmt :=    &#039;insert into deleted.&#039;
                || quote_ident(TG_TABLE_NAME)
                || &#039; select * from public.&#039;
                || quote_ident(TG_TABLE_NAME)
                || &#039; where audit_id = $1;&#039;;

        execute stmt using old.audit_id;

        return old;

end; </code></pre></div>]]></content>
