		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=4500#p4500"/>
		<content type="html"><![CDATA[<p>ok erreur de ma part sur la vie du site <br />j&#039;ai trouvé de moi meme <br />merci et bon week end </p><br /><br /><p>SELECT distinct </p><p>info.table_schema,info.table_name, pde.description</p><p>from </p><p>(select c.*, pc.*, pc.oid as oid</p><p>from pg_catalog.pg_class as pc, information_schema.columns as c</p><p>where pc.relname=c.table_name and c.table_schema != &#039;information_schema&#039; and c.table_schema != &#039;pg_catalog&#039;) as info </p><p>LEFT OUTER JOIN </p><p>(SELECT pc.*, PD.*</p><p>FROM pg_catalog.pg_description PD right outer join pg_catalog.pg_class PC</p><p>on PD.objoid = PC.oid AND PD.objsubid = 0 ) as pde</p><p>on info.oid = pde.objoid</p><p>where </p><p>info.table_schema = &#039;nomduschema&#039;;</p>]]></content>
