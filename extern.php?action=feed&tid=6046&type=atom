	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  postmaster.pid probleme]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=32594#p32594"/>
		<content type="html"><![CDATA[<p>qu&#039;est qui est corrompu au juste ?<br />une base de données precise ou carrément tout le cluster de bases de données ?</p>]]></content>
		<author>
			<name><![CDATA[icadedt]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=839</uri>
		</author>
