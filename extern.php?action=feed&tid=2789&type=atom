		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=18200#p18200"/>
		<content type="html"><![CDATA[<p>/etc/init.d postgresql-8.3 stop <br />rm -rf /opt/PostgreSQL <br />rm /etc/postgres-reg.ini <br />rm -rf /etc/init.d/postgresql-8.3 <br />userdel postgres</p>]]></content>
