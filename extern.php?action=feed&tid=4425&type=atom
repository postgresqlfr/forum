			<name><![CDATA[Ulysse]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=7782</uri>
		</author>
		<updated>2017-10-19T16:56:13Z</updated>
		<id>http://forums.postgresql.fr/viewtopic.php?pid=26266#p26266</id>
