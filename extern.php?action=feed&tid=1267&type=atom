					# (change requires restart)
ident_file = &#039;/media/databases/pgsql/data/pg_ident.conf&#039;	# ident configuration file
					# (change requires restart)

#------------------------------------------------------------------------------
# CONNECTIONS AND AUTHENTICATION
#------------------------------------------------------------------------------

# - Connection Settings -

