	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  inserer dans une table à partir de plusieurs tables]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=19923#p19923"/>
		<content type="html"><![CDATA[<p>merci rjuju pour tes explications </p><p>comment faire alors pour remplir une table à partier de plusieurs tables</p><p>et si j&#039;ai une autre table4(col1,col3)</p><p>insert into table1(col1,col2,col3,col4,col4,col5,col6)</p><p>select col1,col2<br />from table4,table2<br />where table4.col1 = table2.col1</p><p>select col5 , col6<br />from table3,table4<br />where table2.col3 = table4.col3</p>]]></content>
		<author>
			<name><![CDATA[tatou]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=3453</uri>
		</author>
