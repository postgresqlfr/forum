		<title type="html"><![CDATA[Réponse à&#160;:  Requête incorrecte utilisant la clause With]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=22855#p22855"/>
		<content type="html"><![CDATA[<p>Désolé,</p><p>Je n&#039;ai fourni la bonne requête posant problème.</p><p>La voici ci-dessous :</p><div class="codebox"><pre><code>CREATE TABLE temp_res AS
 SELECT * FROM (WITH req1 as (SELECT DISTINCT hierar FROM sfphierd 
                               UNION
                              SELECT DISTINCT hierar FROM sfpsupl)
 SELECT DISTINCT groupe,libelle FROM sfpgrps WHERE groupe NOT IN (SELECT DISTINCT grouph FROM hopempl)
  INTERSECT
 SELECT DISTINCT hierar,libelle FROM sfphierg WHERE hierar NOT IN (SELECT * FROM req1)
);	</code></pre></div>]]></content>
