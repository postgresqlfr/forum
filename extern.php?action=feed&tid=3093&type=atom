	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  Problème avec une requete plpgsql]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=19650#p19650"/>
		<content type="html"><![CDATA[<p>Bonjour,</p><p>essayez ça :<br />CREATE OR REPLACE FUNCTION nb_mission() RETURNS integer AS<br />$$<br />DECLARE<br />&#160; count_total integer;<br />BEGIN<br />SELECT COUNT(*) FROM mission into count_total;<br />return count_total;<br />END;<br />$$<br />LANGUAGE plpgsql;</p>]]></content>
