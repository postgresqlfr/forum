	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  Requête avec deux conditions]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=31339#p31339"/>
		<content type="html"><![CDATA[<p>Pourquoi ne pas utiliser quelquechose comme &quot;update matable set variable2 = case when... end where ...&quot; ?</p>]]></content>
		<author>
			<name><![CDATA[rjuju]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=1368</uri>
		</author>
		<updated>2020-07-06T11:48:23Z</updated>
