	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  Problème index]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=10970#p10970"/>
		<content type="html"><![CDATA[<p>Le deuxième index : CREATE INDEX i ON y (y_principal) WHERE issupprime=false, fonctionne si je met une valeur définie à y_principal mais pas si je met is null</p>]]></content>
		<author>
			<name><![CDATA[Julien]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=1385</uri>
		</author>
