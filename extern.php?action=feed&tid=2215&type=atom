		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=14931#p14931"/>
		<content type="html"><![CDATA[<p>Ça marche parfaitement pour moi une fois que je supprime le &quot;RETURN NEW&quot;. J&#039;ai ce code :</p><div class="codebox"><pre><code>CREATE OR REPLACE FUNCTION public.test_while()
 RETURNS trigger 
 LANGUAGE plpgsql 
AS $function$

DECLARE
compteur integer := 1;
total integer := 5;
BEGIN
   
while total &gt; compteur
loop

insert into test_audit (nom_employe,salaire) values (&#039;fred&#039;,(select (1+compteur)));
compteur :=compteur+1;
end loop;
RETURN NULL;
END
$function$;</code></pre></div>]]></content>
