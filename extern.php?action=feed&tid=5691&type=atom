webFXTreeConfig.loadingText		= &quot;&lt;?php echo $lang[&#039;strloading&#039;] ?&gt;&quot;;
webFXTreeConfig.errorIcon		= &quot;&lt;?php echo $misc-&gt;icon(&#039;ObjectNotFound&#039;) ?&gt;&quot;;
