	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  Datawarehouse et Postgresql]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=24819#p24819"/>
		<content type="html"><![CDATA[<p>Même réponse que rjuju. Un ajout cependant: ne pas désactiver le VACUUM. Merci <img src="http://forums.postgresql.fr/img/smilies/smile.png" width="15" height="15" alt="smile" /></p>]]></content>
		<author>
			<name><![CDATA[gleu]]></name>
