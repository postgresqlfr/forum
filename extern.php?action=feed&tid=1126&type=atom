		<id>http://forums.postgresql.fr/viewtopic.php?pid=7278#p7278</id>
	</entry>
	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  Encore des questions...]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=7277#p7277"/>
		<content type="html"><![CDATA[<p>Donc pour vous, il vaut mieux utiliser le vacuum &#039;pas full&#039; de temps en temps en journée, sur une ou plusieurs tables de l&#039;instance ?</p>]]></content>
		<author>
			<name><![CDATA[genio]]></name>
