		<title type="html"><![CDATA[Réponse à&#160;:  CDC en PostgreSQL]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=6757#p6757"/>
		<content type="html"><![CDATA[<p>C&#039;est bon j&#039;ai reussi à régler mon problème j&#039;ai appliquer ce script :<br />CREATE TABLE logs2 <br />AS<br />SELECT <br />&#160; &#160; 0::BIGINT AS operation_id,<br />&#160; &#160; &#039;&#039;::char AS operation,<br />&#160; &#160; current_timestamp::timestamp AS operation_time,<br />&#160; &#160; src2.*<br />FROM src2<br />WHERE 1 = 0;</p><p>ALTER TABLE logs2 ADD PRIMARY KEY(operation_id);<br />CREATE SEQUENCE operation_id_seq ;<br />ALTER TABLE logs2 ALTER operation_id SET DEFAULT nextval(&#039;operation_id_seq&#039;::regclass);<br />ALTER TABLE logs2 ALTER operation_time SET DEFAULT current_timestamp;<br />&#160; &#160; &#160; &#160; <br />CREATE OR REPLACE FUNCTION audit_src2() RETURNS TRIGGER AS $logs2$<br />BEGIN<br />&#160; &#160; IF (TG_OP = &#039;DELETE&#039;) THEN<br />&#160; &#160; &#160; &#160; INSERT INTO logs2 VALUES (DEFAULT,&#039;D&#039;, DEFAULT, OLD.*);<br />&#160; &#160; &#160; &#160; RETURN OLD;<br />&#160; &#160; ELSIF (TG_OP = &#039;UPDATE&#039;) THEN<br />&#160; &#160; &#160; &#160; INSERT INTO logs2 VALUES (DEFAULT,&#039;U&#039;, DEFAULT, NEW.*);<br />&#160; &#160; &#160; &#160; RETURN NEW;<br />&#160; &#160; ELSIF (TG_OP = &#039;INSERT&#039;) THEN<br />&#160; &#160; &#160; &#160; INSERT INTO logs2 VALUES (DEFAULT,&#039;I&#039;, DEFAULT, NEW.*);<br />&#160; &#160; &#160; &#160; RETURN NEW;<br />&#160; &#160; END IF;<br />&#160; &#160; RETURN NULL; -- le résultat est ignoré car il s&#039;agit d&#039;un trigger AFTER<br />END;<br />$logs2$ language plpgsql;<br />&#160; &#160; &#160; &#160; <br />CREATE TRIGGER logs2<br />&#160; &#160; AFTER INSERT OR UPDATE OR DELETE ON src2<br />&#160; &#160; FOR EACH ROW EXECUTE PROCEDURE audit_src2();</p><p>Et c&#039;est parfait !</p>]]></content>
