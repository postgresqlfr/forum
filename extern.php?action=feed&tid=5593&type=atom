		<title type="html"><![CDATA[Réponse à&#160;:  Pb Fonction avec dates]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=30173#p30173"/>
		<content type="html"><![CDATA[<p>Re,</p><br /><p>Merci !</p><p>Testé et approuvé... <img src="http://forums.postgresql.fr/img/smilies/smile.png" width="15" height="15" alt="smile" /></p><br /><p>create or replace function FP_DYN_DATE(varchar) <br />returns date as $$<br />select case<br />&#160; &#160; when $1 = &#039;YESDAT&#039; then current_date - 1<br />&#160; &#160; when $1 = &#039;AUJDAT&#039; then current_date<br />&#160; &#160; when $1 = &#039;J-2DAT&#039; then current_date - 2<br />&#160; &#160; when $1 = &#039;DERM0&#039;&#160; then to_date(to_char(date_trunc(&#039;MONTH&#039;, CURRENT_DATE) + INTERVAL &#039;1MONTH - 1DAY&#039;, &#039;YYYYMMDD&#039;), &#039;YYYYMMDD&#039;)<br />end;<br />$$ LANGUAGE sql IMMUTABLE;</p>]]></content>
