	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  Passer le nom d'un Champ comme paramètre d'une proc. stockée]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=2013#p2013"/>
		<content type="html"><![CDATA[<p>J&#039;ai essayé cette écriture</p><div class="codebox"><pre><code> 

CREATE OR REPLACE FUNCTION __searchtest2(character, character)
  RETURNS bigint AS
$BODY$
PREPARE  test(character,character) AS SELECT prod_version FROM vprod_details
WHERE $1=$2;
 
EXECUTE test(&#039;prod_ref&#039;,&#039;ZA01820C&#039;); 
 
$BODY$
  LANGUAGE &#039;sql&#039; VOLATILE
  COST 100;
ALTER FUNCTION __searchtest(character, character) OWNER TO postgres;</code></pre></div><p>J&#039;ai l&#039;erreur suivante</p><p>ERROR: return type mismatch in function declared to return bigint<br />DÉTAIL : Function&#039;s final statement must be a SELECT.<br />CONTEXTE : SQL function &quot;__searchtest2&quot;</p>]]></content>
