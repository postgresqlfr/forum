	<entry>
		<title type="html"><![CDATA[Réponse à&#160;:  Réplication par fichier journaux : fonctionnement aléatoire...]]></title>
		<link rel="alternate" href="http://forums.postgresql.fr/viewtopic.php?pid=18843#p18843"/>
		<content type="html"><![CDATA[<p>Après avoir recréé le maître, vous avez fait de nouveau une sauvegarde du maître ? après la configuration ?</p>]]></content>
		<author>
			<name><![CDATA[gleu]]></name>
			<uri>http://forums.postgresql.fr/profile.php?id=3</uri>
		</author>
		<updated>2013-12-19T16:10:16Z</updated>
		<id>http://forums.postgresql.fr/viewtopic.php?pid=18843#p18843</id>
